.craft-menu {
    position: absolute;

    width: 60%;
    height: 60%;

    left: 10%;
    top: 10%;
}

.background {
    position: absolute;

    width: 80%;
    height: 80%;

    left: 10%;
    top: 10%;

    -unity-scale-mode: stretch-to-fill;
}

.crafting-title {
    position: absolute;

    left: 18%;
    right: 0;
    top: 20px;

    height: 40px;

    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.recipe-list-panel {
    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 18%;

    border-right-width: 2px;
    border-right-color: black;

    padding-top: 25px;
}

.recipe-list {
    width: 100%;
    height: 100%;

    align-items: center;
}

.recipe-slot {
    width: 60px;
    height: 60px;
    margin-bottom: 15px;
    background-color: rgb(90, 90, 90);
    border-width: 2px;
    border-color: black;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}

.recipe-slot:focus {
    background-color: rgb(90, 90, 90);
}

.recipe-slot.selected {
    border-width: 4px;
}

.recipe-slot:hover {
    background-color: rgb(90, 90, 90);
}

.recipe-image {
    width: 45px;
    height: 45px;

    -unity-scale-mode: scale-to-fit;
}

.crafting-content {
    position: absolute;

    left: 18%;
    right: 0;

    top: 70px;
    bottom: 0;

    align-items: center;
}

.craft-description {
    width: 80%;

    min-height: 70px;

    margin-top: 10px;
    margin-bottom: 15px;

    font-size: 16px;

    -unity-text-align: upper-center;
}

.ingredient-grid {
    width: 100%;
    height: 110px;

    flex-direction: row;

    justify-content: center;
    align-items: center;
}

.ingredient-slot {
    width: 250px;
    height: 250px;

    margin-left: 10px;
    margin-right: 10px;

    background-color: rgb(90, 90, 90);

    border-width: 2px;
    border-color: black;

    position: relative;

    align-items: center;
    justify-content: center;
}

.ingredient-image {
    width: 60px;
    height: 60px;

    -unity-scale-mode: scale-to-fit;
}

.ingredient-count {
    position: absolute;

    right: 5px;
    bottom: 3px;

    font-size: 16px;

    color: #E3CECE;

    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.craft-button {
    width: 200px;
    height: 55px;

    margin-top: 70px;

    font-size: 20px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    background-color: rgb(90, 90, 90);

    border-width: 2px;
    border-color: black;
}

