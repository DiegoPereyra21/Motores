.inventory-panel {
    position: absolute;

    width: 45%;
    min-width: 400px;

    left: 50%;
    top: 50%;

    translate: -50% -50%;

    padding: 25px;

    background-color: rgb(30, 30, 30);

    border-width: 2px;
    border-color: black;
}

.inventory-title {
    color: white;
    font-size: 40px;
    margin-bottom: 20px;
    text-align: center;
}

.inventory-grid {
    width: 100%;

    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory-slot {
    width: 30%;
    height: 220px;

    margin-left: 1.5%;
    margin-right: 1.5%;
    margin-bottom: 10px;

    background-color: rgb(100, 100, 100);

    border-width: 1px;
    border-color: black;

    position: relative;
}

.slot-title {
    width: 100%;
    height: 20px;

    margin-top: 5px;

    font-size: 20px;

    -unity-text-align: upper-center;
}

.slot-image {
    position: absolute;

    width: 140px;
    height: 140px;

    left: 50%;
    top: 28px;

    translate: -50% 10;

    -unity-scale-mode: scale-to-fit;
}

.slot-count {
    position: absolute;

    right: 5px;
    bottom: 5px;

    font-size: 16px;

    -unity-font-style: bold;

    -unity-text-align: middle-right;
}