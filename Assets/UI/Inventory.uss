
.inventory-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    padding: 24px;
    height: 100%;
    background-color: rgba(11, 22, 20, 0.95);
    border-width: 2px;
    border-color: rgb(125, 119, 94);
}

.inventory-content {
    width: 70%;
    align-self: center;
    align-items: stretch;

    background-color: rgba(11, 22, 20, 0.8);

    border-width: 1px;
    border-color: rgba(125, 96, 66, 0.75);
}

.inventory-header {
    width: 100%;
    flex-shrink: 0;
    box-sizing: border-box;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    margin-bottom: 14px;
    background-color: rgb(17, 31, 30);
    border-bottom-width: 3px;
    border-bottom-color: rgb(125, 53, 49);
}

.inventory-heading {
    flex-direction: column;
    flex-grow: 1;
}

.inventory-title {
    color: rgb(221, 207, 172);
    -unity-font-style: bold;
    font-size: 26px;
    letter-spacing: 2px;
}

.inventory-subtitle {
    margin-top: 4px;
    color: rgb(137, 146, 131);
    font-size: 11px;
}

.inventory-capacity {
    align-items: flex-end;
    justify-content: center;
    padding-left: 16px;
    border-left-width: 1px;
    border-left-color: rgb(76, 84, 75);
}

.capacity-label {
    color: rgb(137, 146, 131);
    font-size: 10px;
    -unity-font-style: bold;
}

.capacity-count {
    margin-top: 3px;
    color: rgb(221, 207, 172);
    font-size: 20px;
    -unity-font-style: bold;
}

.inventory-body {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-shrink: 0;
    margin-top: 16px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 710px;
    flex-shrink: 0;
    padding: 8px;
    background-color: rgb(8, 16, 15);
    border-width: 1px;
    border-color: rgb(45, 54, 46);
    border-radius: 4px;

    padding-top: 8px;
    padding-right: 4px;
    padding-bottom: 8px;
    padding-left: 16px;
}

.inventory-slot {
    width: 130px;
    height: 130px;
    flex-shrink: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: rgb(207, 195, 162);
    border-width: 2px;
    border-color: rgb(125, 119, 94);
    border-radius: 5px;
}

.slot-image {
    width: 76px;
    height: 76px;
    align-self: center;
    margin-top: 8px;
    -unity-image-scale-mode: scale-to-fit;
}

.slot-title {
    width: 100%;
    margin-top: 4px;
    padding-left: 2px;
    padding-right: 2px;

    color: rgb(35, 42, 35);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.slot-count {
    position: absolute;
    left: 4px;
    top: 4px;

    color: rgb(48, 75, 43);
    font-size: 18 px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf");

}

.quick-access-pocket {
    width: 270px;
    min-width: 270px;
    flex-shrink: 0;

    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    padding: 14px 12px;

    background-color: rgba(18, 28, 27, 0.88);

    border-width: 1px;
    border-color: rgb(125, 112, 83);
    border-radius: 8px;
}

.pocket-title {
    width: 100%;
    margin-bottom: 12px;
    padding-bottom: 8px;

    color: rgb(218, 207, 177);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    border-bottom-width: 1px;
    border-bottom-color: rgb(112, 49, 46);
}

.pocket-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    align-items: flex-start;

    width: 240px;
    flex-shrink: 0;
}

.quick-slot {
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    margin: 2px;

    background-color: rgba(35, 29, 25, 0.9);
    border-width: 1px;
    border-color: rgb(125, 96, 66);
}
