
.interaction-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.interaction-prompt {
    position: absolute;
    top: 56%;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    padding: 14px 20px;

    background-color: rgba(11, 27, 24, 0.97);

    border-width: 2px;
    border-color: rgb(111, 96, 67);
}

.prompt-key {
    color: rgb(225, 211, 184);
    background-color: rgb(111, 52, 46);

    padding: 4px 10px;
    margin-right: 11px;

    border-width: 1px;
    border-color: rgb(160, 117, 91);

    -unity-font-style: bold;
    font-size: 18px;
}

.prompt-text {
    color: rgb(218, 207, 183);
    font-size: 17px;
    -unity-font-style: bold;
}

.interaction-menu {
    position: absolute;
    top: 58%;

    width: 400px;
    min-width: 400px;
    max-width: 450px;

    padding: 22px;

    background-color: rgba(11, 27, 24, 0.98);

    border-width: 2px;
    border-color: rgb(111, 96, 67);
}

.menu-title {
    color: rgb(222, 207, 177);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;

    margin-bottom: 16px;
    padding-bottom: 12px;

    border-bottom-width: 2px;
    border-bottom-color: rgb(113, 58, 50);
}

.actions-container {
    flex-direction: column;
}

.close-hint {
    color: rgb(133, 151, 143);

    font-size: 12px;
    -unity-text-align: right;

    margin-top: 16px;
    padding-top: 12px;

    border-top-width: 1px;
    border-top-color: rgb(72, 91, 72);
}

.interaction-menu {
    border-width: 2px;
    border-color: rgb(111, 96, 67);
}

.action-button {
    min-height: 52px;

    margin-bottom: 9px;
    padding: 10px 15px;

    background-color: rgb(25, 43, 37);
    color: rgb(218, 207, 183);

    border-width: 1px;
    border-color: rgb(111, 96, 67);

    -unity-font-style: normal;

    font-size: 17px;
}

.action-button:hover {
    background-color: rgb(55, 69, 53);
    border-color: rgb(160, 117, 91);
}

.action-button:disabled {
    background-color: rgb(24, 29, 26);
    color: rgb(105, 112, 103);
    border-color: rgb(65, 69, 62);
}