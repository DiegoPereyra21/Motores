<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tutorial.uss?fileID=7433441132597879392&amp;guid=7378a2d44b27f554fb926a74fa4dbc16&amp;type=3#Tutorial"/>
    <ui:VisualElement name="TutorialOverlay" class="tutorial-overlay" style="top: -3px; bottom: 6px; right: 0; left: 0; display: none;">
        <ui:VisualElement name="TutorialWindow" class="tutorial-window" style="background-image: url(&quot;project://database/Assets/Art/Tutorial/parchmentish00.png?fileID=2800000&amp;guid=b6f5ed168e5a1d34db2adbeaf54db93f&amp;type=3#parchmentish00&quot;); color: rgb(218, 220, 207); -unity-background-image-tint-color: rgb(77, 91, 80);">
            <ui:VisualElement name="TutorialHeader" class="tutorial-header">
                <ui:Label name="TutorialTitle" text="• GUIA DE SUPERVIVENCIA •" class="tutorial-title" style="-unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); font-size: 40px; color: rgb(218, 207, 181);"/>
            </ui:VisualElement>
            <ui:VisualElement class="tutorial-separator"/>
            <ui:VisualElement name="InstructionsContainer" class="instructions-container" style="justify-content: space-between; top: 1px;">
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="key-group">
                            <ui:VisualElement class="keycap">
                                <ui:Label text="W" class="keycap-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="keycap">
                                <ui:Label text="A" class="keycap-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="keycap">
                                <ui:Label text="S" class="keycap-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="keycap">
                                <ui:Label text="D" class="keycap-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Movimiento" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="mouse-icon">
                            <ui:VisualElement class="mouse-button left"/>
                            <ui:VisualElement class="mouse-button right"/>
                            <ui:VisualElement class="mouse-wheel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Mover camara" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="mouse-icon">
                            <ui:VisualElement class="mouse-button left left-active"/>
                            <ui:VisualElement class="mouse-button right"/>
                            <ui:VisualElement class="mouse-wheel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Atacar" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="key-group">
                            <ui:VisualElement class="keycap">
                                <ui:Label text="E" class="keycap-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Interactuar / Saquear" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="key-group">
                            <ui:VisualElement class="keycap">
                                <ui:Label text="I" class="keycap-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Abrir inventario" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="key-group">
                            <ui:VisualElement class="keycap">
                                <ui:Label text="Q" class="keycap-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Abrir acciones rapidas" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="key-group">
                            <ui:VisualElement class="keycap">
                                <ui:Label text="1" class="keycap-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="keycap">
                                <ui:Label text="2" class="keycap-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="keycap">
                                <ui:Label text="3" class="keycap-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="keycap">
                                <ui:Label text="4" class="keycap-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Cambiar entre slots rapidos" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="mouse-icon">
                            <ui:VisualElement class="mouse-button left"/>
                            <ui:VisualElement class="mouse-button right right-active"/>
                            <ui:VisualElement class="mouse-wheel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Curarse con objeto equipado" class="instruction-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row long-instruction">
                    <ui:VisualElement class="input-container">
                        <ui:Label text="DOBLE CLIC / ARRASTRAR" class="input-label" style="font-size: 16px;"/>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Asignar objetos al acceso rapido" class="instruction-label" style="font-size: 19px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="instruction-row" style="border-bottom-width: 0;">
                    <ui:VisualElement class="input-container">
                        <ui:VisualElement class="mouse-icon">
                            <ui:VisualElement class="mouse-button left"/>
                            <ui:VisualElement class="mouse-button right right-active"/>
                            <ui:VisualElement class="mouse-wheel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="→" class="instruction-arrow"/>
                    <ui:Label text="Retirar objetos del acceso rápido" class="instruction-label" style="font-size: 19px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="tutorial-separator"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
