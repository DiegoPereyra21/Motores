<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD.uss?fileID=7433441132597879392&amp;guid=0c40e13878fb2c3449ec84ae715ab497&amp;type=3#HUD"/>
    <ui:VisualElement name="HUD" class="hud" style="top: 0; bottom: 3px; right: 0; left: 1px;">
        <ui:VisualElement name="Day" class="day" style="height: 89px; width: 293px; flex-direction: row;">
            <ui:Label name="DayLabel" text="DIA 1" style="height: 59px; width: 113px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;);"/>
            <ui:Label text="-" name="SeparatorLabel" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-text-align: middle-center; left: 16px;"/>
            <ui:Label text="Label" name="TimeLabel" class="time-label" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-text-align: middle-center; left: 21px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Equipment" class="equipment">
            <ui:VisualElement name="Radio" class="indicator" style="width: 200px; height: 200px; top: -37px;">
                <ui:VisualElement name="RadioIcon" class="radio-icon" style="background-image: resource(&quot;radio/radio_off&quot;); -unity-background-scale-mode: scale-to-fit; width: 200px; height: 200px; right: -32px; top: 26px;"/>
                <ui:Label name="RadioAlert" text="Sin mensaje" class="radio-alert"/>
            </ui:VisualElement>
            <ui:VisualElement name="Backpack" class="indicator" style="width: 170px; height: 170px; -unity-background-scale-mode: stretch-to-fill; top: 366px; right: -68px;">
                <ui:VisualElement name="BackpackIcon" class="backpack-icon" style="background-image: resource(&quot;bag&quot;); width: 100px; height: 110px; display: flex; -unity-background-scale-mode: stretch-to-fill;"/>
                <ui:Label name="KeyLabel" text="I" class="key-label" style="left: 9px; bottom: 25px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Tutorial" class="indicator" style="width: 170px; height: 170px; -unity-background-scale-mode: stretch-to-fill; top: 37px; right: -68px;">
                <ui:VisualElement name="TutorialIcon" class="backpack-icon" style="background-image: url(&quot;project://database/Assets/Art/Icons/psx-horror-ui-icons/addons/psx_horror_ui/icons/large/note.png?fileID=2800000&amp;guid=ebd911b8add056c4fa8aabbf4d98ac5d&amp;type=3#note&quot;); width: 100px; height: 110px; display: flex; -unity-background-scale-mode: stretch-to-fill;"/>
                <ui:Label name="KeyLabel" text="T" class="key-label" style="left: 9px; bottom: 25px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Health" class="health">
            <ui:Label name="HealthLabel" text="Salud" enable-rich-text="true" style="font-size: 25px; right: 7px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;);"/>
            <ui:VisualElement name="HealthBar" class="health-bar">
                <ui:VisualElement name="HealthBackground" class="health-background">
                    <ui:VisualElement name="HealthFill" class="health-fill" style="background-color: rgb(63, 17, 22);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Selector" class="selector" style="right: 20px;">
            <ui:VisualElement name="Wheel" class="wheel">
                <ui:VisualElement name="Slot1" class="slot slot-1">
                    <ui:VisualElement name="Icon1" picking-mode="Position" class="slot-icon" style="background-image: none; right: -16px; width: 80px; height: 80px; top: 10px;"/>
                    <ui:VisualElement name="Durability" picking-mode="Position" class="durability" style="bottom: -13px; right: -14px; width: 70%; margin-top: 5px; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Slot2" class="slot slot-2">
                    <ui:VisualElement name="Icon2" class="slot-icon" style="background-image: none; top: 10px; right: 16px; width: 80px; height: 80px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: -13px; right: 14px; width: 70%; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Slot3" class="slot slot-3">
                    <ui:VisualElement name="Icon3" class="slot-icon" style="background-image: none; right: -15px; bottom: 9px; width: 80px; height: 80px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: 6px; right: -26px; width: 70%; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Slot4" class="slot slot-4">
                    <ui:VisualElement name="Icon4" class="slot-icon" style="background-image: none; right: 13px; width: 80px; height: 80px; bottom: 9px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: 6px; right: 26px; width: 70%; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill" style="bottom: 0; right: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="VerticalLine" class="vertical-line"/>
                <ui:VisualElement name="HorizontalLine" class="horizontal-line"/>
            </ui:VisualElement>
            <ui:Label name="KeyLabel" text="Q" class="key-label" style="font-size: 30px; left: -34px; bottom: -11px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-font-style: bold;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
