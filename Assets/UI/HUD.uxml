<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD.uss?fileID=7433441132597879392&amp;guid=0c40e13878fb2c3449ec84ae715ab497&amp;type=3#HUD"/>
    <ui:VisualElement name="HUD" class="hud" style="top: 0; bottom: 3px; right: 0; left: 1px;">
        <ui:VisualElement name="Day" class="day" style="height: 89px; width: 293px; flex-direction: row;">
            <ui:Label name="DayLabel" text="DIA 1" style="height: 59px; width: 113px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;);"/>
            <ui:Label text="-" name="SeparatorLabel" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-text-align: middle-center; left: 16px;"/>
            <ui:Label text="Label" name="TimeLabel" class="time-label" style="font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-text-align: middle-center; left: 21px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Health" class="health">
            <ui:Label name="HealthLabel" text="Salud" enable-rich-text="true" style="font-size: 25px; right: 7px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;);"/>
            <ui:VisualElement name="HealthBar" class="health-bar">
                <ui:VisualElement name="HealthBackground" class="health-background">
                    <ui:VisualElement name="HealthFill" class="health-fill" style="background-color: rgb(63, 17, 22);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Selector" class="selector" style="right: 20px;">
            <ui:VisualElement name="Wheel" class="wheel">
                <ui:VisualElement name="Slot1" class="slot slot-1">
                    <ui:VisualElement name="Icon1" class="slot-icon" style="background-image: none; right: -16px; width: 80px; height: 80px; top: 10px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: -13px; right: -14px; width: 70%; margin-top: 5px; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Slot2" class="slot slot-2">
                    <ui:VisualElement name="Icon2" class="slot-icon" style="background-image: none; top: 10px; right: 16px; width: 80px; height: 80px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: -13px; right: 14px; width: 70%; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Slot3" class="slot slot-3">
                    <ui:VisualElement name="Icon3" class="slot-icon" style="background-image: none; right: -15px; bottom: 9px; width: 80px; height: 80px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: 6px; right: -26px; width: 70%; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Slot4" class="slot slot-4">
                    <ui:VisualElement name="Icon4" class="slot-icon" style="background-image: none; right: 13px; width: 80px; height: 80px; bottom: 9px;"/>
                    <ui:VisualElement name="Durability" class="durability" style="bottom: 6px; right: 26px; width: 70%; display: none;">
                        <ui:VisualElement name="DurabilityFill" class="durability-fill" style="bottom: 0; right: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="VerticalLine" class="vertical-line"/>
                <ui:VisualElement name="HorizontalLine" class="horizontal-line"/>
            </ui:VisualElement>
            <ui:Label name="KeyLabel" text="Q" class="key-label" style="font-size: 30px; left: -15px; bottom: -7px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="LootNotificationContainer" picking-mode="Ignore" class="loot-notification-container" style="position: absolute; top: 936px; left: 904px; -unity-text-align: middle-left; align-self: center; align-items: center; justify-content: flex-start; align-content: center; width: 120px; height: 120px;"/>
        <ui:VisualElement name="InteractionFeedback" picking-mode="Ignore" class="interaction-feedback" style="top: 41px; left: 979px; width: 680px;">
            <ui:VisualElement picking-mode="Ignore" class="interaction-feedback-header">
                <ui:VisualElement class="interaction-feedback-indicator"/>
                <ui:Label name="InteractionFeedbackTitle" text="MATERIALES INSUFICIENTES" class="interaction-feedback-title"/>
            </ui:VisualElement>
            <ui:Label name="InteractionFeedbackText" picking-mode="Ignore" class="interaction-feedback-text"/>
        </ui:VisualElement>
        <ui:VisualElement name="Equipment" class="equipment">
            <ui:VisualElement name="Radio" class="indicator" style="width: 200px; height: 200px; top: 0; right: -10px; flex-direction: column; justify-content: flex-start; align-items: center; align-self: center; align-content: flex-start;">
                <ui:VisualElement name="RadioIcon" class="radio-icon" style="background-image: url(&quot;project://database/Assets/Art/Icons/icons/item_radio_off.png?fileID=2800000&amp;guid=96eac2d5eab5bc8439c37ed495b17877&amp;type=3#item_radio_off&quot;); -unity-background-scale-mode: scale-to-fit; width: 150px; height: 150px; right: -27px; top: -30px;"/>
                <ui:Label name="RadioAlert" text="Sin mensajes" class="radio-alert" style="display: flex; padding-top: 0; margin-top: -20px; left: 33px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); font-size: 20px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Backpack" class="indicator" style="width: 170px; height: 170px; -unity-background-scale-mode: stretch-to-fill; top: 318px; right: -68px;">
                <ui:VisualElement name="BackpackIcon" class="backpack-icon" style="background-image: url(&quot;project://database/Assets/Art/Icons/icons/item_mochila.png?fileID=2800000&amp;guid=326c574c73d438347adebd1fc3a890c4&amp;type=3#item_mochila&quot;); width: 130px; height: 150px; display: flex; -unity-background-scale-mode: stretch-to-fill;"/>
                <ui:Label name="KeyLabel" text="I" class="key-label" style="left: 2px; bottom: -1px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Tutorial" class="indicator" style="width: 170px; height: 170px; -unity-background-scale-mode: stretch-to-fill; top: -16px; right: -68px;">
                <ui:VisualElement name="TutorialIcon" class="backpack-icon" style="background-image: url(&quot;project://database/Assets/Art/Icons/icons/item_tutorial.png?fileID=2800000&amp;guid=e90de5c72fdf3c047b2fdcdce8bbeae0&amp;type=3#item_tutorial&quot;); width: 120px; height: 110px; display: flex; -unity-background-scale-mode: stretch-to-fill;"/>
                <ui:Label name="KeyLabel" text="T" class="key-label" style="left: 0; bottom: 18px; -unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
