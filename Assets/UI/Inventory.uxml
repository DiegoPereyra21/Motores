<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Inventory.uss?fileID=7433441132597879392&amp;guid=e853383466ab6ec4093186abd55c6095&amp;type=3#Inventory"/>
    <ui:VisualElement name="InventoryPanel" class="inventory-panel" style="flex-direction: column; justify-content: space-evenly; align-self: auto; align-content: auto; align-items: center; -unity-background-scale-mode: stretch-to-fill; display: none;">
        <ui:VisualElement name="InventoryContent" class="inventory-content" style="flex-grow: 1;">
            <ui:VisualElement name="InventoryHeader" class="inventory-header">
                <ui:VisualElement class="inventory-heading" style="flex-direction: column;">
                    <ui:Label name="InventoryTitle" text="INVENTARIO" class="inventory-title" style="-unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); font-size: 35px;"/>
                    <ui:Label name="InventorySubtitle" text="GESTIONA TU EQUIPO Y SUMINISTROS" class="inventory-subtitle" style="font-size: 20px; padding-left: 5px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="InventoryCapacity" class="inventory-capacity">
                    <ui:Label name="CapacityLabel" text="CAPACIDAD" class="capacity-label"/>
                    <ui:Label name="CapacityCount" text="0 / 30" class="capacity-count"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="InventoryBody" class="inventory-body" style="flex-grow: 1;">
                <ui:VisualElement name="InventoryGrid" class="inventory-grid" style="left: 0; padding-left: 16px; padding-right: 4px; -unity-text-align: middle-left; align-self: center; justify-content: flex-start; align-items: center; align-content: auto; flex-direction: row; flex-wrap: wrap;"/>
                <ui:Button text="" name="HoverToggleButton" class="hover-toggle-button" style="position: absolute; top: 25px; left: 882px; background-image: none; height: 42px; width: 46px; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-background-scale-mode: stretch-to-fill; align-self: center; justify-content: space-between; align-items: center;">
                    <ui:Image name="HoverIcon" style="background-image: none; width: 40px; height: 40px;"/>
                </ui:Button>
                <ui:VisualElement name="QuickAccessPocket" class="quick-access-pocket" style="flex-direction: column; flex-wrap: nowrap; justify-content: center; padding-top: 14px; bottom: -266px; left: 9px;">
                    <ui:Label text="ACCESO RAPIDO" name="PocketTitle" class="pocket-title" style="-unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;);"/>
                    <ui:VisualElement name="PocketGrid" style="flex-grow: 1; flex-wrap: wrap; align-self: center; justify-content: center; flex-direction: row;">
                        <ui:VisualElement name="QuickSlot_01" class="quick-slot"/>
                        <ui:VisualElement name="QuickSlot_02" class="quick-slot"/>
                        <ui:VisualElement name="QuickSlot_03" class="quick-slot"/>
                        <ui:VisualElement name="QuickSlot_04" class="quick-slot"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SortButtonsContainer" class="sort-buttons-container" style="flex-direction: column; flex-wrap: nowrap; position: absolute; top: 682px; left: 902px; width: 230px; min-width: 220px; height: 177px; justify-content: space-between;">
                    <ui:Label text="ORDENAR" name="SortTitle" class="sort-title" style="-unity-font-definition: url(&quot;project://database/Assets/Font/Special_Elite/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=97e524c46899f544dab576384d085a88&amp;type=3#SpecialElite-Regular&quot;); bottom: 4px;"/>
                    <ui:Button text="Por nombre (A-Z)" name="SortName" class="sort-button"/>
                    <ui:Button text="Por Cantidad" name="SortAmount" class="sort-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="ItemTooltip" class="item-tooltip" style="flex-grow: 1; position: absolute;">
                    <ui:Label text="Label" name="TooltipItemName" class="item-tooltip-name"/>
                    <ui:Label text="Label" name="TooltipCategory" class="item-tooltip-category"/>
                    <ui:VisualElement name="TooltipDivider" class="item-tooltip-divider" style="flex-grow: 1;"/>
                    <ui:Label text="Label" name="TooltipAmount" class="item-tooltip-detail"/>
                    <ui:Label text="Label" name="TooltipDurability" class="item-tooltip-detail"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
