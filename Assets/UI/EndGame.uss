/* ==============================
   ESTILOS GENERALES
   ============================== */

.ending-root {
    width: 100%;
    height: 100%;
    position: relative;

    background-color: rgba(0, 0, 0, 0);

    justify-content: center;
    align-items: center;
}

.ending-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;

    flex-direction: column;
    justify-content: flex-start;
    align-items: center;

    padding-left: 8%;
    padding-right: 8%;
    padding-top: 4%;
    padding-bottom: 3%;

    background-color: rgba(0, 0, 0, 0);
}

.ending-title {
    width: 100%;

    color: rgb(220, 220, 220);
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;

    margin-top: 0;
    margin-bottom: 12px;
}

.ending-description {
    width: 80%;

    color: rgb(190, 190, 190);
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;

    margin-bottom: 0;
}

.ending-button {
    width: 300px;
    min-height: 52px;

    margin-top: 8px;
    margin-bottom: 8px;

    padding-left: 20px;
    padding-right: 20px;

    background-color: rgb(43, 47, 49);
    color: rgb(235, 235, 235);

    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;

    border-top-color: rgb(95, 100, 102);
    border-bottom-color: rgb(95, 100, 102);
    border-left-color: rgb(95, 100, 102);
    border-right-color: rgb(95, 100, 102);

    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;

    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ending-button:hover {
    background-color: rgb(75, 38, 38);
    color: rgb(255, 255, 255);

    border-top-color: rgb(160, 75, 75);
    border-bottom-color: rgb(160, 75, 75);
    border-left-color: rgb(160, 75, 75);
    border-right-color: rgb(160, 75, 75);
}

.ending-button:active {
    background-color: rgb(110, 42, 42);
}

.ending-button:focus {
    border-top-color: rgb(190, 90, 90);
    border-bottom-color: rgb(190, 90, 90);
    border-left-color: rgb(190, 90, 90);
    border-right-color: rgb(190, 90, 90);
}


/* ==============================
   TITULOS POR TIPO DE FINAL
   ============================== */

#VictoryTitle {
    color: rgb(190, 205, 170);
}

#DefeatTitle {
    color: rgb(190, 150, 115);
}


/* ==============================
   PANTALLA DE MUERTE
   ============================== */

.death-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;

    -unity-background-scale-mode: scale-and-crop;

    opacity: 1;

    pointer-events: none;
}

#DeathPanel {
    justify-content: flex-start;
    align-items: center;

    padding-top: 4%;
    padding-bottom: 4%;
}

#DeathTitle {
    width: 100%;

    color: rgb(190, 85, 85);
    font-size: 120px;
    -unity-text-align: middle-center;

    margin-top: 400px;
    margin-bottom: 16px;
}

#DeathDescription {
    width: 100%;
    font-size: 26px;
    -unity-text-align: middle-center;

    margin-bottom: 0;
}

/* Botones */
#DeathCheckpointButton,
#DeathMainMenuButton {
    width: 250px;
    min-height: 62px;

    margin-top: 10px;
    margin-bottom: 10px;

    padding-left: 24px;
    padding-right: 24px;

    background-color: rgba(15, 15, 15, 0.88);
    color: rgb(220, 215, 210);

    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-right-width: 1px;

    border-top-color: rgb(90, 65, 65);
    border-bottom-color: rgb(90, 65, 65);
    border-left-color: rgb(155, 45, 45);
    border-right-color: rgb(90, 65, 65);

    border-top-left-radius: 0;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 2px;
}

/* Interaccion de los botones */
#DeathCheckpointButton:hover,
#DeathMainMenuButton:hover {
    background-color: rgba(75, 18, 18, 0.96);
    color: rgb(255, 240, 235);

    border-left-color: rgb(235, 55, 55);
    border-top-color: rgb(155, 55, 55);
    border-bottom-color: rgb(155, 55, 55);
    border-right-color: rgb(155, 55, 55);
}

#DeathCheckpointButton:active,
#DeathMainMenuButton:active {
    background-color: rgb(110, 20, 20);
    color: rgb(255, 255, 255);
}

#DeathCheckpointButton:focus,
#DeathMainMenuButton:focus {
    border-left-color: rgb(255, 65, 65);
    border-top-color: rgb(190, 65, 65);
    border-bottom-color: rgb(190, 65, 65);
    border-right-color: rgb(190, 65, 65);
}

#DeathCheckpointButton {
    margin-top: auto;
    margin-bottom: 8px;
}

#DeathMainMenuButton {
    margin-top: 8px;
    margin-bottom: -2%;
}

#BlackScreen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-color: black;
    opacity: 0;

    display: none;
}